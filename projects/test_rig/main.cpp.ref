// ============================================================================
// main.cpp — ТОЧКА ВХОДА ТЕСТОВОЙ СБОРКИ (Arduino: setup/loop)
// ============================================================================
// Для PlatformIO это src/main.cpp; для arduino-cli — содержимое .ino
// (см. test_sketch/README). Вся система запускается ОДНОЙ строкой —
// ядро само поднимает модули, драйверы, шину и Safe Mode.
// ============================================================================
#include <Arduino.h>
#include "../core/Kernel.h"
#include "TestProfile.h"

void setup() {
    // Полная загрузка МикроОС 5.0 с тестовым профилем.
    // Для боевого устройства здесь: Kernel::run<SmartLockProfile>().
    Kernel::getInstance().run<TestProfile>();
}

void loop() {
    Kernel::getInstance().loop();
}
